{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "News Feed",
  "version": "0.12.1",
  "identifier": "app.newsfeed.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "News Feed",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "center": true,
        "resizable": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCONFIG/thumbs/*",
          "$APPDATA/thumbs/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "News Feed",
    "category": "News",
    "shortDescription": "Đọc tin công nghệ dạng dashboard",
    "longDescription": "Tổng hợp tin công nghệ từ nhiều nguồn thành cụm sự kiện, đọc bài đã loại bỏ quảng cáo.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Vietnamese",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "../installer/header.bmp",
        "sidebarImage": "../installer/sidebar.bmp"
      },
      "wix": {
        "bannerPath": "../installer/banner.bmp",
        "dialogImagePath": "../installer/dialog.bmp"
      }
    }
  }
}
